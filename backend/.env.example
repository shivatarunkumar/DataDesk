# Metadata DB (users, grants, workspace files, upload requests) — see ../database/schema.sql
DATAMANAGER_DATABASE_URL=postgresql+asyncpg://<user>:<pass>@localhost:5432/datadesk
# Any DB on the Postgres server that hosts upload targets; the name is swapped per target table
TARGET_DATABASE_URL=postgresql+asyncpg://<user>:<pass>@localhost:5432/postgres
JWT_SECRET=change-me
