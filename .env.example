# DataDesk configuration: the single source for app + GCP settings.
# Copy to .env (cp .env.example .env) and set the database URLs and the GCP project/bucket.
# The API, the database scripts and the Make targets all read this one file; nothing else
# in the codebase hardcodes a host, bucket or project.
# Keep comments on their own lines (inline comments end up inside the value).

# ================================================================ app
# local | dev | stage | prod
APP_ENV=local

# INFO  one line per request, plus decisions worth knowing about (why a 401 happened,
#       failed logins, uploads, loads into target tables)
# DEBUG full trace of each call: every SQL statement with its duration, every storage and
#       BigQuery round-trip, each health check timed
LOG_LEVEL=INFO
# text for a terminal, json for Cloud Logging
LOG_FORMAT=text
# every SQL statement SQLAlchemy runs: enormous, so opt in when you need it
SQL_ECHO=false
API_BASE_URL=http://localhost:8001
WEB_BASE_URL=http://localhost:3001
# comma-separated
CORS_ORIGINS=http://localhost:3001

# Ports differ from KnowHub (8000/3000) so both apps can run side by side.
API_HOST_PORT=8001
WEB_HOST_PORT=3001

# ================================================================ database (metadata)
# admin connection: used only by `make db-init` to create the role, database and extensions
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# app connection: role, password and database are created from this URL by `make db-init`
DATABASE_URL=postgresql+asyncpg://datadesk:datadesk@localhost:5432/datadesk
# connections the API keeps open to it
DB_POOL_SIZE=5

# ================================================================ auth
# signs the access-token cookie. Generate one with: openssl rand -hex 32
# It must never be blank; outside local it must also be 32+ random characters.
JWT_SECRET=change-me
# how long a sign-in lasts
ACCESS_TOKEN_TTL_MIN=720

# ================================================================ gcp
# Credentials come from Application Default Credentials:
#   gcloud auth application-default login
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account key file.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
# DataDesk's own service account. Every BigQuery and GCS call impersonates it, so loads run
# (and are audited) as the application, not as whoever is signed in to gcloud. No key file:
# your gcloud user (or the runtime's account on GCP) needs roles/iam.serviceAccountTokenCreator
# on it. Empty = use Application Default Credentials as they are (a personal login locally).
GCP_SERVICE_ACCOUNT=
# true: Test access FAILS (and blocks onboarding) when DataDesk would run as a personal gcloud
# login. false: that is shown as a warning only. Turn it on once GCP_SERVICE_ACCOUNT is set up.
ENFORCE_APP_IDENTITY=false

# ================================================================ storage (GCS)
# Bucket that backs every user's workspace. Files live under
#   {GCS_WORKSPACE_PREFIX}/{user_id}/{folder path}/v{n}_{file name}
# The credentials need roles/storage.objectAdmin on it.
GCS_BUCKET=your-workspace-bucket
GCS_WORKSPACE_PREFIX=workspaces
# set → fake-gcs-server or another emulator; leave EMPTY for real GCS
GCS_ENDPOINT_URL=

# ================================================================ bigquery (upload targets)
BQ_ENABLED=true
# project that owns the target datasets and pays for the load jobs; empty → GCP_PROJECT_ID
BQ_PROJECT_ID=
# where load and MERGE jobs run; empty → the dataset's own location (usually what you want)
BQ_LOCATION=

# ================================================================ file upload (Cloud Run)
# The File upload tab sends files to BigQuery through the Cloud Run file processor
# (cloud-run-poc): after approval DataDesk copies the file into the landing bucket, and
# reads job_metadata / validation_metadata back to show what happened. Leave the buckets
# empty to switch the tab off. DataDesk's credentials need roles/storage.objectAdmin on
# both buckets and roles/bigquery.dataViewer on the audit dataset.
FILE_UPLOAD_LANDING_BUCKET=
# Cloud Run reads data contracts from here; DataDesk publishes one YAML per onboarded table
FILE_UPLOAD_CONFIG_BUCKET=
FILE_UPLOAD_CONTRACTS_PREFIX=contracts/
# files land at {prefix}/{request id}/{name the contract expects}
FILE_UPLOAD_LANDING_PREFIX=datadesk
# dataset in BQ_PROJECT_ID (or GCP_PROJECT_ID) with job_metadata and validation_metadata
FILE_UPLOAD_AUDIT_DATASET=file_audit
# no Cloud Run job this many minutes after landing → the request says it wasn't picked up
FILE_UPLOAD_PICKUP_MINUTES=5
# Pub/Sub delivery attempts before a message goes to the dead-letter topic (match the subscription)
FILE_UPLOAD_MAX_ATTEMPTS=5
# how often the API reads Cloud Run's progress for requests still with it (0 = only when viewed)
FILE_UPLOAD_POLL_SECONDS=15

# ================================================================ limits
# largest file a user may upload (50 MB)
MAX_UPLOAD_BYTES=52428800
# rows above this are rejected when a file is parsed
MAX_ROWS=100000

# Data Studio: rows shown per query, rows changed per submission, query timeout (seconds),
# and the most a BigQuery query may scan (bytes; 1 GB)
STUDIO_ROW_LIMIT=1000
STUDIO_MAX_CHANGES=500
STUDIO_QUERY_TIMEOUT_SECONDS=30
STUDIO_MAX_BYTES_BILLED=1073741824
